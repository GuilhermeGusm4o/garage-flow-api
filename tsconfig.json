{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@common/*": ["src/common/*"],
      "@service/*": ["src/modules/service/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@inventory/*": ["src/inventory/*"],
      "@infra/*": ["src/infra/*"],
      "@generated/prisma/*": ["generated/prisma/*"]
    },
    "sourceMap": true,
    "declaration": true,
    "removeComments": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  }
}
